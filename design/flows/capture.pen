      "name": "BRIEF — Capture · desktop (as-is)",
      "clip": true,
      "width": 640,
      "height": 900,
      "fill": "$paper",
      "cornerRadius": "$radius-2xl",
      "stroke": "$line",
      "strokeWidth": 1,
      "layout": "vertical",
