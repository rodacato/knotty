      "gap": 10,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "L9EAF",
          "name": "Heading",
          "fill": "$graphite",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "BRIEF — Studio · desktop",
