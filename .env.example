# Copia este archivo a .env y llena lo que vayas a usar. .env no se sube a git.
SHELLM_HOST=
SHELLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Qué correr: proveedor:modelo separados por coma.
KNOTTY_MODELS=shellm:claude
# De a cuántos pedidos a la vez; 1 para no cargar al servidor.
KNOTTY_PARALLEL=1
