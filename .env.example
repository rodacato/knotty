# Copy this file to .env and fill in what you will use. .env is not committed to git.
SHELLM_HOST=
SHELLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# What to run: provider:model, comma-separated.
KNOTTY_MODELS=shellm:claude
# How many requests at a time; 1 to avoid loading the server.
KNOTTY_PARALLEL=1
